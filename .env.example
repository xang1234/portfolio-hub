# --- IBKR credentials (REQUIRED for live trading) ---
# Live IB account username and password
IB_USER=your_ib_username
IB_PASS=your_ib_password

# TRADING_MODE is "live" for the live account or "paper" for paper trading.
# From sibling containers, connect through the socat ports documented below.
# Slice 1 default is "live" per the locked-in plan decision.
TRADING_MODE=live

# Login mode: read-only login skips IBKR 2FA and blocks order management at
# login level. Keep this enabled for portfolio-hub's read-only dashboard flow.
READ_ONLY_LOGIN=yes

# 2FA fallback if READ_ONLY_LOGIN is disabled. IBKR Mobile push needs one tap
# on the phone per day after the daily restart.
TWOFA_DEVICE=mobile
RELOGIN_AFTER_TWOFA_TIMEOUT=yes

# Read-only API: REQUIRED for v1. Prevents accidental order placement.
# Set to "no" only after order entry is intentionally added.
READ_ONLY_API=yes

# Allow the dashboard container to reach IB Gateway over the Docker bridge.
TRUSTED_IPS=127.0.0.1,172.16.0.0/12

# --- Dashboard ---
# Where the dashboard finds IB Gateway. Inside docker-compose this is the service
# name; for local dev against a host gateway, use "localhost".
IB_HOST=ib-gateway
# Use 4003 (socat-forwarded live) when connecting from another container — the
# gateway binds 4001/4002 to loopback only. socat exposes 4003 → 127.0.0.1:4001
# (live) and 4004 → 127.0.0.1:4002 (paper) on the container's bridge interface,
# making the connection appear as 127.0.0.1 from the gateway's perspective so it
# bypasses TrustedIPs.
IB_PORT=4003
IB_CLIENT_ID=1

# Which brokers are enabled. Use "ibkr,futu" to show IBKR and MooMoo/Futu together.
BROKERS_ENABLED=ibkr

# --- MooMoo / Futu OpenD ---
# OpenD must be running and logged into the same account. From Docker Desktop on
# macOS, host.docker.internal reaches OpenD running on the host. For local
# non-Docker development, use 127.0.0.1.
# Optional helper: scripts/setup_opend.py can install/check/start command-line
# OpenD from a local .opend/ directory, but login credentials still live in
# OpenD's own config/UI, not in this file.
FUTU_HOST=host.docker.internal
FUTU_PORT=11111
FUTU_MARKETS=HK,US,SG
# Common values: FUTUSG (Moomoo SG), FUTUINC (Moomoo US), FUTUSECURITIES (Futu HK).
FUTU_SECURITY_FIRM=FUTUSG
FUTU_TRD_ENV=REAL
FUTU_REFRESH_CACHE=false
FUTU_POLL_INTERVAL_S=30
# Leave blank to use OpenD's configured encryption setting.
FUTU_ENCRYPT=

# Timezone for IB Gateway daily restart, snapshot scheduling, and UI time hints.
# Use an IANA name (e.g., Asia/Singapore, Asia/Hong_Kong, America/New_York).
TZ=Asia/Singapore

# --- Host port published to the Tailnet interface ---
# Keep 8080 unless something else on the host already binds it.
DASHBOARD_PORT=8080
